<?xml version="1.0"?>
<package format="3">
  <name>alive_lio</name>
  <version>0.0.0</version>

  <description>
    ALIVE-LIO: Degeneracy-Aware Learning of Inertial Velocity for Enhancing
    ESKF-Based LiDAR-Inertial Odometry.
  </description>

  <maintainer email="seongjun4527@g.postech.edu">Seongjun Kim</maintainer>

  <license>GPL-2.0</license>

  <author email="seongjun4527@g.postech.edu">Seongjun Kim</author>
  <author>Daehan Lee</author>
  <author>Junwoo Hong</author>
  <author>Sanghyun Park</author>
  <author>Hyunyoung Jo</author>
  <author>Soohee Han</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen</depend>
  <depend>sophus</depend>
  <build_depend>libpcl-all-dev</build_depend>
  <exec_depend>libpcl-all</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>python3-yaml</test_depend>
  <export><build_type>ament_cmake</build_type></export>
